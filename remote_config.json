{
  "// ===== Basic Website Settings =====": "Control the main website and links",
  "websiteUrl": "https://sorymohajer.github.io",
  "websiteName": "WebControl X",
  "homepageUrl": "https://sorymohajer.github.io/WebView-Pro/",

  "// ===== Enable/Disable Main Features =====": "Control the features available to users",
  "featuresEnabled": {
    "sectionsEnabled": true,
    "favoritesEnabled": true,
    "offlineStorageEnabled": true,
    "shareEnabled": true,
    "notificationsEnabled": true,
    "searchEnabled": true,
    "darkModeEnabled": true,
    "compactModeEnabled": true,
    "themeSelectionEnabled": true,
    "aboutPageEnabled": true,
    "contactPageEnabled": true,
    "privacyPageEnabled": true,
    "settingsEnabled": true,
    "splashScreenEnabled": true,
    "exitConfirmationEnabled": true
  },

  "// ===== Sections Settings =====": "Customize the sections shown in the app",
  "sections": [
    {
      "name": "News",
      "url": "/search/label/الأخبار",
      "icon": "article",
      "color": "#2196F3",
      "enabled": true
    },
    {
      "name": "Security Programs",
      "url": "/search/label/برامج حماية",
      "icon": "security",
      "color": "#4CAF50",
      "enabled": true
    },
    {
      "name": "Drivers",
      "url": "/search/label/تعريفات",
      "icon": "settings",
      "color": "#FF9800",
      "enabled": true
    },
    {
      "name": "Windows",
      "url": "/search/label/ويندوز",
      "icon": "computer",
      "color": "#9C27B0",
      "enabled": true
    },
    {
      "name": "Android",
      "url": "/search/label/أندرويد",
      "icon": "phone_android",
      "color": "#00BCD4",
      "enabled": false
    },
    {
      "name": "Apps",
      "url": "/search/label/تطبيقات",
      "icon": "apps",
      "color": "#E91E63",
      "enabled": false
    }
  ],

  "// ===== Offline Storage Settings =====": "Control the offline storage feature",
  "offlineStorage": {
    "autoSaveEnabled": true,
    "maxStorageMB": 100,
    "autoEvictEnabled": true,
    "warn90PercentEnabled": true,
    "compressionEnabled": true
  },

  "// ===== Notifications Settings =====": "Control types of notifications",
  "notifications": {
    "localNotificationsEnabled": true,
    "fcmEnabled": true,
    "newsSubscriptionEnabled": true,
    "storageWarningsEnabled": true
  },

  "// ===== Themes Settings =====": "Customize available themes",
  "themes": {
    "defaultTheme": "CodeEditorDarkModern",
    "availableThemes": [
      {
        "key": "CodeEditorDarkModern",
        "name": "Dark Code Editor",
        "enabled": true
      },
      {
        "key": "GitHubLight",
        "name": "GitHub Light",
        "enabled": false
      },
      {
        "key": "GitHubDark",
        "name": "GitHub Dark",
        "enabled": true
      },
      {
        "key": "HighContrast",
        "name": "High Contrast",
        "enabled": true
      }
    ]
  },

  "// ===== Security Settings =====": "Protection and security settings",
  "security": {
    "allowedOrigins": ["https://sorymohajer.github.io"],
    "allowSubdomains": true,
    "certPinningEnabled": true,
    "strictMixedContentEnabled": true,
    "acceptThirdPartyCookies": false,
    "screenRecordingProtection": false
  },

  "// ===== Network Settings =====": "Control network behavior",
  "network": {
    "bridgeRateLimitPerMinute": 30,
    "bridgeReplayProtectionEnabled": true,
    "bridgeRequestLoginEnabled": false,
    "bridgeCopyToClipboardEnabled": true,
    "mixedContentMode": "never",
    "internalNavigationEnabled": true,
    "externalOpenEnabled": true
  },

  "// ===== UI Settings =====": "Customize the user interface",
  "ui": {
    "skeletonEnabled": true,
    "animationsEnabled": true,
    "hapticFeedbackEnabled": true,
    "swipeRefreshEnabled": true,
    "pullToRefreshEnabled": true
  },

  "// ===== AdMob Settings =====": "Control all advertisement features",
  "ads": {
    "enabled": true,
    "testMode": true,
    "gdprEnabled": true,
    "adUnits": {
      "appId": "ca-app-pub-3940256099942544~3347511713",
      "bannerId": "ca-app-pub-3940256099942544/6300978111",
      "interstitialId": "ca-app-pub-3940256099942544/1033173712",
      "appOpenId": "ca-app-pub-3940256099942544/9257395921"
    },
    "bannerAds": {
      "enabled": true,
      "position": "bottom",
      "size": "adaptive",
      "refreshInterval": 60
    },
    "interstitialAds": {
      "enabled": true,
      "showOnAppStart": true,
      "showOnPageLoad": true,
      "showInterval": 300,
      "maxPerSession": 5
    },
    "appOpenAds": {
      "enabled": true,
      "showOnColdStart": false,
      "showOnWarmStart": true,
      "timeout": 4000
    },
    "privacy": {
      "consentRequired": true,
      "debugGeography": "EEA",
      "testDeviceIds": []
    }
  },

  "// ===== App Info =====": "Information about the app",
  "appInfo": {
    "appName": "WebControl X",
    "appSubtitle": "Advanced Code Editor",
    "version": "1.0.0",
    "developer": "Sory Mohajer",
    "supportEmail": "support@WebControlX.com",
    "aboutUrl": "https://sorymohajer.github.io/WebView-Pro/about.html",
    "privacyPolicyUrl": "https://sorymohajer.github.io/WebView-Pro/privacy.html",
    "contactUrl": "https://sorymohajer.github.io/WebView-Pro/support.html",
    "termsOfServiceUrl": "https://sorymohajer.github.io/WebView-Pro/terms.html"
  },

  "// ===== UI Strings =====": "Customize text displayed in the app",
  "uiStrings": {
    "settingsTitle": "Settings",
    "settingsSubtitle": "Customize your experience",
    "navigationLabels": {
      "home": "Home",
